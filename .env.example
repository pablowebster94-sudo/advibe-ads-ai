# ───────── Base de datos (PostgreSQL) ─────────
# Neon, Supabase, Vercel Postgres, etc.  Ejemplo:
DATABASE_URL="postgresql://usuario:clave@host:5432/advibe_ads_ai?sslmode=require"

# ───────── Seguridad ─────────
# Firma de sesión (mínimo 32 caracteres aleatorios)
SESSION_SECRET=""
# Cifrado de tokens y claves guardadas en la base (cualquier cadena larga y aleatoria)
ENCRYPTION_KEY=""
# Usuario inicial. Se crea la primera vez que inicias sesión con estas credenciales.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Para las tareas programadas (Vercel Cron envía este valor como Bearer)
CRON_SECRET=""

# ───────── URL pública de la app ─────────
APP_URL="https://tu-dominio.vercel.app"

# ───────── Meta (opcional para OAuth; sin esto puedes conectar con token de usuario del sistema) ─────────
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v23.0"

# ───────── Proveedores de IA (también se pueden guardar cifrados desde Configuración) ─────────
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
