generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  PENDING
  CONNECTED
  ERROR
}

enum CampaignStatus {
  DRAFT
  PAUSED
  ACTIVE
  ARCHIVED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  role         String     @default("OWNER")
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
}

model Client {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  industry       String?
  website        String?
  whatsapp       String?
  location       String?
  brandColor     String            @default("#5aae33")
  secondaryColor String            @default("#00602b")
  typography     String            @default("Inter")
  logoUrl        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  products       Product[]
  assets         CreativeAsset[]
  creatives      Creative[]
  campaigns      Campaign[]
  strategies     Strategy[]
  rules          AutomationRule[]
  assignments    ClientAdAccount[]
}

model Product {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  description String?
  offer       String?
  price       Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
}

model AdAccount {
  id             String            @id @default(cuid())
  externalId     String            @unique
  name           String
  status         Status            @default(PENDING)
  currency       String?
  timezoneName   String?
  tokenCiphertext String?
  tokenIv        String?
  tokenTag       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  assignments    ClientAdAccount[]
  campaigns      Campaign[]
}

model ClientAdAccount {
  id          String    @id @default(cuid())
  clientId    String
  adAccountId String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  @@unique([clientId, adAccountId])
}

model Campaign {
  id            String         @id @default(cuid())
  clientId      String
  adAccountId   String
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  adAccount     AdAccount      @relation(fields: [adAccountId], references: [id])
  metaCampaignId String?       @unique
  name          String
  objective     String
  budget        Decimal        @db.Decimal(12, 2)
  status        CampaignStatus @default(DRAFT)
  createdAt     DateTime       @default(now())
  metrics       DailyMetric[]
}

model CreativeAsset {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  type      String
  url       String
  createdAt DateTime @default(now())
}

model Creative {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  imageUrl    String?
  promptUsed  String?
  aspectRatio String   @default("4:5")
  primaryText String   @default("")
  headline    String   @default("")
  createdAt   DateTime @default(now())
}

model Strategy {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  brief     Json
  output    Json
  createdAt DateTime @default(now())
}

model DailyMetric {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date        DateTime
  spend       Decimal  @db.Decimal(12, 2)
  impressions Int
  reach       Int
  clicks      Int
  leads       Int      @default(0)
  conversions Int      @default(0)
  revenue     Decimal  @default(0) @db.Decimal(12, 2)

  @@unique([campaignId, date])
}

model AutomationRule {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  metric    String
  operator  String
  threshold Float
  action    String   @default("ALERT_ONLY")
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())
}
